{
  "description": "Always asks the human to confirm the target account and flow before a flow is saved.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*sapot-flows__save_flow",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm_save.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
